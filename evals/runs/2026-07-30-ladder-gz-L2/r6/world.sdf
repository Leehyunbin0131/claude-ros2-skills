<?xml version="1.0" ?>
<!--
  Differential-drive robot with a 360-sample GPU lidar, inside a walled
  arena (so every lidar ray always hits something within range_max).

  Drive it:
    gz topic -t "/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 0.3}, angular: {z: 0.2}"
  Read the lidar:
    gz topic -e -t /scan
-->
<sdf version="1.9">
  <world name="diff_drive_lidar_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <!-- This sandbox has no accessible /dev/dri device, so the Ogre2
           headless-EGL path cannot initialize a GPU context. The legacy
           Ogre1 render engine works with Mesa's software rasterizer
           (LIBGL_ALWAYS_SOFTWARE=1, set by bringup.sh) instead. -->
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Square arena walls: 4x4 m interior. Keeps every lidar hit within
         about 5 m (comfortably inside the 8 m sensor range) so every one
         of the 360 rays reports a finite range no matter where the robot
         is in the room, including corners. (A larger, e.g. 8x8, room was
         tested and pushed some hits past ~5 m, which triggers occasional
         non-finite returns from the software-rendered lidar in this
         sandbox - see bringup.sh for why software rendering is used.)
         Walls also physically contain the robot so this stays true as it
         drives around. -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="wall_north_collision">
          <pose>0 2 0.5 0 0 0</pose>
          <geometry><box><size>4.2 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="wall_north_visual">
          <pose>0 2 0.5 0 0 0</pose>
          <geometry><box><size>4.2 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>

        <collision name="wall_south_collision">
          <pose>0 -2 0.5 0 0 0</pose>
          <geometry><box><size>4.2 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="wall_south_visual">
          <pose>0 -2 0.5 0 0 0</pose>
          <geometry><box><size>4.2 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>

        <collision name="wall_east_collision">
          <pose>2 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 4.0 1.0</size></box></geometry>
        </collision>
        <visual name="wall_east_visual">
          <pose>2 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 4.0 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>

        <collision name="wall_west_collision">
          <pose>-2 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 4.0 1.0</size></box></geometry>
        </collision>
        <visual name="wall_west_visual">
          <pose>-2 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 4.0 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="diff_drive_robot">
      <pose>0 0 0.12 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.0125</ixx>
            <iyy>0.0217</iyy>
            <izz>0.0313</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.25 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.9 1</ambient>
            <diffuse>0.2 0.4 0.9 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.25 0.15</size>
            </box>
          </geometry>
        </collision>
      </link>

      <link name="left_wheel">
        <pose>-0.05 0.15 -0.02 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.000234</ixx>
            <iyy>0.000234</iyy>
            <izz>0.0004</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="right_wheel">
        <pose>-0.05 -0.15 -0.02 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.000234</ixx>
            <iyy>0.000234</iyy>
            <izz>0.0004</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="caster">
        <pose>0.13 0 -0.06 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00004</ixx>
            <iyy>0.00004</iyy>
            <izz>0.00004</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.03</radius></sphere>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.03</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.01</mu>
                <mu2>0.01</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="lidar_link">
        <pose>0 0 0.11 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <iyy>0.00001</iyy>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>

        <sensor name="gpu_lidar" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>scan</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.08</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name="caster_wheel" type="ball">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <joint name="lidar_joint" type="fixed">
        <parent>chassis</parent>
        <child>lidar_link</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.3</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <max_linear_acceleration>2</max_linear_acceleration>
        <min_linear_acceleration>-2</min_linear_acceleration>
        <max_angular_acceleration>4</max_angular_acceleration>
        <min_angular_acceleration>-4</min_angular_acceleration>
        <max_linear_velocity>1.0</max_linear_velocity>
        <min_linear_velocity>-1.0</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
      </plugin>

    </model>

  </world>
</sdf>
