n        while rclpy.ok() and node.detection_count < MAX_DETECTIONS:\n            rclpy.spin_once(node, timeout_sec=1.0)\n    finally:\n        node.destroy_node()\n        rclpy.shutdown()\n    sys.exit(0)\n\n\nif __name__ == '__main__':\n    main()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8564,"cache_read_input_tokens":17618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8564},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"87c5fa62-f2f5-475b-bb2e-ebfdc72d93c9","uuid":"d14a120b-3016-4749-b24c-a9bbd7ea8241","timestamp":"2026-07-31T15:59:00.800Z","request_id":"req_011CdaQqU9DTVahzeddob92q"}
