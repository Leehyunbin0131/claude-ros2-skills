or_link', Time())\n        except TransformException as ex:\n            self.get_logger().debug(f'Could not look up transform: {ex}')\n            return\n\n        x = trans.transform.translation.x\n        y = trans.transform.translation.y\n        z = trans.transform.translation.z\n        self.get_logger().info(f'TF {x} {y} {z}')\n\n        self.timer.cancel()\n        self.done = True\n\n\ndef main():\n    rclpy.init()\n    node = StaticTfNode()\n    try:\n        while rclpy.ok() and not node.done:\n            rclpy.spin_once(node, timeout_sec=1.0)\n    finally:\n        node.destroy_node()\n        rclpy.shutdown()\n\n    sys.exit(0)\n\n\nif __name__ == '__main__':\n    main()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8494,"cache_read_input_tokens":17618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8494},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5807c13a-5e50-4d8d-b2fb-4e5d4a67288e","uuid":"41f3983d-7082-4378-8441-c1c3b8f79863","timestamp":"2026-07-31T23:46:06.343Z","request_id":"req_011Cdb2TrnKm94bWooXznTmx"}
