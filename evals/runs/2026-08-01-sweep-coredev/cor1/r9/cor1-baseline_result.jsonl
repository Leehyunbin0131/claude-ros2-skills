or_link', Time())\n            except (LookupException, ConnectivityException, ExtrapolationException):\n                rclpy.spin_once(self, timeout_sec=0.1)\n                continue\n\n            x = trans.transform.translation.x\n            y = trans.transform.translation.y\n            z = trans.transform.translation.z\n            self.get_logger().info(f'TF {x} {y} {z}')\n            return True\n        return False\n\n\ndef main(args=None):\n    rclpy.init(args=args)\n    node = StaticTfNode()\n    try:\n        success = node.lookup_and_log()\n    finally:\n        node.destroy_node()\n        rclpy.shutdown()\n    sys.exit(0 if success else 1)\n\n\nif __name__ == '__main__':\n    main()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8490,"cache_read_input_tokens":17618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8490},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dda1173-7ec7-4890-a852-bb1439fc4d8b","uuid":"ce7d0131-1b5e-4221-bc14-6043d6e28e90","timestamp":"2026-07-31T23:47:00.694Z","request_id":"req_011Cdb2XoAe9wYa8aTps1AxR"}
